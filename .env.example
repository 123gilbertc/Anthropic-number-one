# LiveKit (Cloud or self-hosted)
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional: transcription (Phase 1+)
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=

# Optional: storage for progressive uploads (Phase 1+)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=anglecast-recordings

# Optional: generative multi-angle providers (Phase 2)
# STABILITY_API_KEY=
# KLING_API_KEY=
