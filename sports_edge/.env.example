# Copy to sports_edge/.env and fill in. Never commit .env.
# Nothing here enables real-money trading; the code has no order submission.

# Operator token for commands in the UI/API (generated into runs/api_token if unset)
SPORTS_EDGE_API_TOKEN=

DATABASE_URL=postgresql+psycopg://sports_edge:sports_edge@localhost:5432/sports_edge

# Kalshi market data. The WebSocket needs a signed API key even for public channels.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# UNVERIFIED for sports series: read GET /series/{ticker} and update (see DATA_SOURCES.md)
KALSHI_FEE_RATE=0.07

# The Odds API (sportsbook reference). Free tier = 500 credits/month.
ODDS_API_KEY=
ODDS_API_REGIONS=us,eu

# LLM shadow reviews: disabled unless all four are set. Verify IDs/prices in official docs first.
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=
LLM_ANTHROPIC_INPUT_USD_PER_MTOK=
LLM_ANTHROPIC_OUTPUT_USD_PER_MTOK=
LLM_MONTHLY_BUDGET_USD=25

# Discord alerts stay disabled until explicitly enabled.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
